    "cards":  [
                  {
                      "dot":  "amber",
                      "title":  "Transfer path \u0026 saga compensation",
                      "items":  [
                                    "Orchestrator checks Redis idempotency (SET NX EX 60), calls Risk Engine (â‰¤200ms SLA), then dispatches OFS command to T24 Mock CBS.",
                                    "CBS acquires pessimistic row locks in Oracle XE, commits the debit/credit mutation, and publishes outbox events to Kafka.",
                                    "On timeout or risk BLOCK, Orchestrator issues a compensating OFS reversal command (EP2) to immediately restore debited balances."
                                ]
                  },
                  {
                      "dot":  "violet",
                      "title":  "Dual-storage persistence",
                      "items":  [
                                    "Oracle XE 21c is the exclusive operational master: balances, accounts, GL entries, and EOD batch records.",
                                    "PostgreSQL 16 audit vault is append-only; a native trigger rejects all UPDATE and DELETE commands, satisfying BSP non-repudiation requirements.",
                                    "Azurite emulates Azure Blob for compliance PDF/Excel report storage and KYC document vault during local development."
                                ]
                  },
                  {
                      "dot":  "cyan",
                      "title":  "Observability \u0026 dev tooling",
                      "items":  [
                                    "Datadog Agent collects distributed APM traces (OTLP :4318 / :4317), DogStatsD metrics (:8125 UDP), and tail-scrapes all container logs.",
                                    "MailHog (:8025 UI, :1025 SMTP) captures every outbound OTP and receipt email locally without real mail relay.",
                                    "Redis Insight (:5540), Adminer (:8088), and Kafka-UI (:8089) provide live in-browser inspection of all datastores."
                                ]
                  }
              ]
