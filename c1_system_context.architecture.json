  "cards": [
    {
      "dot": "cyan",
      "title": "People and channels",
      "items": [
        "Customers use the Flutter mobile app and the Flutter web portal; both call the platform through the API gateway with a JWT.",
        "Bank staff use the React admin console (Nginx, :3000) for KYC maker-checker review, reversal approvals and compliance reports."
      ]
    },
    {
      "dot": "amber",
      "title": "External systems",
      "items": [
        "Temenos T24 CBS (t24-mock-cbs) is the ledger of record. The orchestrator calls EP1 /funds-transfer to post and EP2 /reversal to compensate, both as OFS text.",
        "Interbank transfers debit the sender into a Nostro account on CBS, then send the wire to the partner bank. A failed wire triggers a compensating reversal."
      ]
    },
    {
      "dot": "violet",
      "title": "Supporting services",
      "items": [
        "Email gateway: notification-service sends OTP and receipt mail through SMTP (MailHog in dev and on the AKS test deploy).",
        "Azure Blob Storage holds KYC documents and generated compliance filings (Azurite locally, a storage account on Azure).",
        "Datadog receives APM traces, logs and metrics from every service through the Datadog agent."
      ]
    }
  ]
