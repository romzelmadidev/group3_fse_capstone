    "cards":  [
                  {
                      "dot":  "emerald",
                      "title":  "Ledger and audit separation",
                      "items":  [
                                    "T24 Mock CBS owns the master ledger in Oracle XE and writes balance changes with row locks.",
                                    "Compliance Service consumes Kafka events into a Postgres audit vault that blocks updates and deletes."
                                ]
                  },
                  {
                      "dot":  "amber",
                      "title":  "Transfer path",
                      "items":  [
                                    "The orchestrator checks idempotency in Redis, asks Risk Service for a verdict, then calls the CBS.",
                                    "A 2FA verdict or a high amount triggers an OTP through Notification Service before funds move."
                                ]
                  },
                  {
                      "dot":  "cyan",
                      "title":  "Observability",
                      "items":  [
                                    "Every service ships traces and logs to a Datadog agent on banking-net (not drawn to keep the map readable)."
                                ]
                  }
              ]
